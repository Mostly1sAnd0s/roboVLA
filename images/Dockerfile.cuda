# robovla-runner-cuda — the per-node runner image (design §6, §10).
#
# The container is the only hardware boundary: it runs the agent on :8601
# and launches job processes with a FIXED argv (no shell, ever). The host
# bind-mounts its workdir (datasets/runs/artifacts) and model volume into
# the standard layout — the quadlet (systemd/robovla-runner.service) does
# the mounting + GPU passthrough.
#
# FINALIZED stack pins (Phase 1, 2026-10-21 — the host65/RTX 4070 sm_89
# silicon probe: bnb8 load 303 s / 7.85 GB on-GPU, fwd+bwd, 1 QLoRA step,
# generate(7) + decode all pass):
#   torch 2.9.0+cu128 — cu128 also carries the sm_120 (Blackwell) kernels;
#   torchvision 0.24.0+cu128 MUST install in the SAME command as torch —
#   a separate PyPI resolve floats both to the latest (2.14+cu130) and
#   silently breaks the pin (caught on host65). The Blackwell leg (pai1,
#   RTX 5090) is still unverified: new pin = new tag + gpu_selftest (§6).
#   transformers 4.51.3 / peft 0.14.0 / bitsandbytes 0.50.2 — the official
#   repo's own pins are older (4.40.1/0.11.1/2.2.0); the custom-code model
#   loads + trains clean on these (the probe's version-check warning is
#   benign).
#   timm 0.9.10 — modeling_prismatic.py HARD-CHECKS timm against
#   {0.9.10, 0.9.11, 0.9.12, 0.9.16}; an unpinned timm (1.x) breaks load.
#
# LAYER ORDERING (cache stability, 2026-10-22): the heavy dependency layers
# (torch ~4 GB, the official TF stack ~1 GB, the pinned git fetches) come
# BEFORE the repo source COPYs, and the .dockerignore keeps this Dockerfile
# out of the build context. The ONE source path the heavy layers depend on
# is images/tfg_stub (the tfg stub install sits inside the TF stack layer) —
# it is COPYed in its own tiny layer before them. Editing src/agent/images
# therefore re-runs only the small source layers (seconds), not the
# dependency layers (tens of minutes).
#
# The openvla CODE is CLONED at a pinned SHA and ALSO pip-installed
# --no-deps (the official install is `pip install -e .`): the clone gives
# the pinned vla-scripts/finetune.py + prismatic sources; the install makes
# `import prismatic` work for the crosscheck job. The console engine path
# does NOT import prismatic — it uses the vendored prompt builder
# (images/vla_compat.py) + pure token math (images/engine.py).
#
# Build (from the repo root):
#   podman build -t robovla-runner-cuda:2026.10.1 -f images/Dockerfile.cuda .

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH"

# uv + Python 3.12 (the image's venv owns the whole stack, §6)
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && ln -s /root/.local/bin/uv /usr/local/bin/uv \
    && uv python install 3.12 \
    && uv venv --python 3.12 /opt/venv

# The Phase 1 pins — BEFORE the repo source COPY (layer-ordering note
# above). torch + torchvision in ONE command (the shared-resolve pin trap).
RUN uv pip install \
        torch==2.9.0+cu128 torchvision==0.24.0+cu128 \
            --index-url https://download.pytorch.org/whl/cu128
RUN uv pip install \
        transformers==4.51.3 peft==0.14.0 bitsandbytes==0.50.2 \
        timm==0.9.10 pillow numpy pyyaml huggingface-hub

# The console wheel inputs + the tfg stub — BEFORE the heavy official
# stack (layer ordering above). The wheel packages src/robovla + agent
# only (pyproject [tool.hatch.build.targets.wheel]) — the images package
# is NOT in the wheel, so this layer does not depend on it.
COPY pyproject.toml README.md /opt/robovla/
COPY src /opt/robovla/src
COPY agent /opt/robovla/agent
COPY images/tfg_stub /opt/robovla/images/tfg_stub
RUN uv pip install /opt/robovla

# Pinned openvla code (Phase 1 SHA — the probe verified every touchpoint
# against it; re-pin = new SHA + new tag + gpu_selftest at node join).
ARG OPENVLA_SHA=c8f03f48af692657d3060c19588038c7220e9af9
RUN git init /opt/openvla \
    && git -C /opt/openvla fetch --depth 1 \
        https://github.com/openvla/openvla "${OPENVLA_SHA}" \
    && git -C /opt/openvla checkout FETCH_HEAD

# Crosscheck build-time workaround (host65 attempt 6, 2026-10-22): the
# pinned finetune.py cannot complete ONE QLoRA step on this image's
# probe-verified stack (torch 2.9.0's implicit non-reentrant checkpoint
# default meets the hardcoded DDP wrap — no static_graph — and the first
# backward dies: "Expected to mark a variable ready only once";
# openvla/openvla#90, a maintainer-acknowledged latent bug, same failure
# signature). The patch IS the #90 fix (static_graph + explicitly
# reentrant checkpointing — mathematically neutral: a DDP communication
# hint at world_size 1 / a recomputation implementation detail). Applied
# --check first (the build fails if the pinned file ever drifts from the
# patch context) and the patched file is sha256-pinned (drift = build
# failure). Documented in the crosscheck results + the wrapper docstring.
COPY images/finetune_patch.diff /tmp/finetune_patch.diff
RUN git -C /opt/openvla apply --check /tmp/finetune_patch.diff \
    && git -C /opt/openvla apply /tmp/finetune_patch.diff \
    && echo "a5600f58cbbe126e29b5ff57e86063d3f65c39ed639f7a7e5b1e0ac6bc12942e  /opt/openvla/vla-scripts/finetune.py" | sha256sum -c

# The official fine-tune stack (crosscheck, §6): vla-scripts/finetune.py at
# the pinned SHA needs its own dependencies — draccus (its config layer),
# accelerate (the DDP PartialState), wandb (its logging; the wrapper execs it
# with WANDB_MODE=disabled — no credentials on the LAN), and the RLDS/TFDS
# data pipeline (tensorflow + tensorflow_datasets + the official dlimp fork,
# a git dep pinned at its 2024-07 commit). Pins: draccus / TFDS are the
# official repo's pins; tensorflow is 2.19.1 because the official 2.15
# predates Python 3.12 (cp312 wheels start at 2.17) and this image is 3.12.
# The official pyproject's torch / transformers / peft / tokenizers pins are
# DELIBERATELY NOT followed — the image keeps the probe-verified stack above
# (downgrading them would re-open the Phase 1 pins). TF is CPU-only here:
# the rlds loader sets tf.config.set_visible_devices([], "GPU") (torch owns
# the GPU), so the GPU wheel is chosen for stack faithfulness, not for a GPU
# path.
#
# tensorflow_metadata — pinned to 1.17.3 (tfds's floating dep). The latest
# release (1.21.0) ships pb2 gencode built with protobuf 6.x, which fails the
# protobuf runtime-version check on load, because TF 2.19.1 forces
# protobuf<6.0.0dev (runtime 5.29.6). 1.17.3 is the last pre-validation
# release (same era as tfds 4.9.3).
#
# tensorflow_graphics — the ONE official pin this image CANNOT follow.
# tensorflow-graphics==2021.12.3 (latest release AND the official pin)
# depends on tensorflow-addons>=0.10.0, and tensorflow-addons 0.23.0 (latest)
# ships wheels only for cp39-cp311, so it is unresolvable on this image's
# Python 3.12 (the uv resolver fails at layer-build time). The pinned openvla
# code imports `tensorflow_graphics.geometry.transformation` at module level
# (oxe/utils/droid_utils.py) but uses it ONLY inside DROID / furniture-bench
# / iamlab / cmu dataset transforms — none of which the crosscheck path
# ('toto', a pure tf.concat standardization) ever calls. So the image ships
# a loud-failure stub (images/tfg_stub): it satisfies the import, and every
# leaf raises a clear RuntimeError on invocation. If a future OXE dataset is
# ever added to the crosscheck, its standardize transform must be verified to
# not touch tfg (or the stub must be replaced with the real package on a
# py<=3.11 image).
RUN uv pip install \
        draccus==0.8.0 accelerate==1.15.0 wandb==0.31.0 \
        tensorflow==2.19.1 tensorflow_datasets==4.9.3 \
        tensorflow_metadata==1.17.3 \
    && uv pip install /opt/robovla/images/tfg_stub
# dlimp installed --no-deps: its setup.py hard-pins tensorflow==2.15.0
# (predates 3.12, no cp312 wheel), which would fail resolution / force a
# downgrade of the image's 2.19.1. Its runtime import surface (dlimp.dataset /
# dlimp.utils / dlimp.transforms) is {tensorflow, tensorflow_datasets,
# numpy} — all already installed above; the convert/dev extras (pandas,
# imageio, tqdm-multiprocess, absl) are builder-only and not imported by the
# openvla RLDS load path.
ARG DLIMP_SHA=040105d256bd28866cc6620621a3d5f7b6b91b46
RUN uv pip install --no-deps \
        "dlimp @ git+https://github.com/moojink/dlimp_openvla@${DLIMP_SHA}"
# The openvla + prismatic packages themselves (the official install is
# `pip install -e .`). --no-deps: the official pyproject pins torch==2.2.0 /
# transformers==4.40.1 / peft==0.11.1 / tokenizers==0.19.1 /
# tensorflow==2.15.0 — following them would re-open the Phase 1 pins. The
# finetune import chain's third-party surface (torch, transformers, peft,
# timm, einops-via-timm, huggingface_hub, dlimp, draccus, tensorflow,
# tensorflow_datasets, the tfg stub above, wandb, accelerate) is all present;
# the only prismatic modules importing extra deps (jsonlines, rich) are
# pretraining/download tooling the crosscheck path never imports.
RUN uv pip install --no-deps /opt/openvla

# The images package (job program / engine / crosscheck wrapper — NOT in
# the wheel): AFTER the heavy layers, so a source edit under images/ re-runs
# only this small COPY + the entrypoint layer (seconds). The tfg_stub files
# were already COPYed before the TF stack layer (its install needs them);
# this re-copies them identically.
COPY images /opt/robovla/images

# Fixed-argv entrypoints (python scripts — never a shell)
COPY images/bin /opt/robovla/bin
RUN chmod +x /opt/robovla/bin/robovla_job /opt/robovla/bin/finetune

# The agent owns the process lifecycle; :8601 is console-only traffic.
# Host mounts (podman quadlet): <host workdir> -> /data, <model volume> -> /models.
# -m agent (NOT -m agent.server): the __main__ guard lives in agent/__main__.py;
# "agent.server" has none, so the process imported and exited silently (exit 0)
# — dead-on-arrival agent. Pinned by tests/integration/test_agent_entrypoint.py,
# which runs this exact argv (host65 first real boot, 2026-10-21).
WORKDIR /data
EXPOSE 8601
ENTRYPOINT ["/opt/venv/bin/python", "-m", "agent"]
